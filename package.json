  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:xdc": "bun run build && rm -rf dist && mkdir -p dist && (cd build && zip -9 -r ../dist/termina.xdc . -x webxdc.js) && cp -f dist/termina.xdc \"$HOME/termina.xdc\"",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/marked": "^6.0.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "almostnode": "^0.2.14",
    "marked": "^18.0.9",
    "xterm": "file:./vendor/xterm.js",
    "xterm-addon-fit": "0.8.0"
  }
}
